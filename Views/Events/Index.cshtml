@model List<EventManagementSystem.Models.Event>

@{
    ViewData["Title"] = "All Events";
}

<!-- Custom CSS -->
<style>
    body {
        background: url('https://images.unsplash.com/photo-1508780709619-79562169bc64?auto=format&fit=crop&w=1350&q=80') no-repeat center center fixed;
        background-size: cover;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 20px 0;
    }

    h3 {
        text-align: center;
        color: #fff;
        margin-bottom: 30px;
        text-shadow: 1px 1px 3px rgba(0,0,0,0.6);
    }

    .card-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
    }

    .event-card {
        background-color: rgba(255, 255, 255, 0.95);
        border-radius: 15px;
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.2);
        width: 300px;
        transition: transform 0.3s, box-shadow 0.3s;
        padding: 20px;
        display: flex;
        flex-direction: column;
    }

        .event-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 35px rgba(0,0,0,0.3);
        }

    .event-title {
        font-size: 1.3rem;
        font-weight: bold;
        color: #333;
        margin-bottom: 10px;
    }

    .event-description {
        color: #555;
        font-size: 0.95rem;
        margin-bottom: 15px;
        min-height: 50px;
    }

    .event-info {
        font-size: 0.9rem;
        margin-bottom: 15px;
        color: #444;
    }

        .event-info strong {
            color: #000;
        }

    .btn-group {
        display: flex;
        justify-content: flex-start;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn {
        flex: 1;
        font-size: 0.85rem;
        padding: 6px 12px;
        border-radius: 8px;
        transition: all 0.2s;
    }

    .btn-primary {
        background: linear-gradient(135deg, #198754, #157347);
        border: none;
        color: #fff;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #157347, #0f5c36);
        }

    .btn-warning {
        background: linear-gradient(135deg, #ffc107, #e0a800);
        border: none;
        color: #212529;
    }

        .btn-warning:hover {
            background: linear-gradient(135deg, #e0a800, #c69500);
        }

    .btn-danger {
        background: linear-gradient(135deg, #dc3545, #b02a37);
        border: none;
        color: #fff;
    }

        .btn-danger:hover {
            background: linear-gradient(135deg, #b02a37, #991f2a);
        }

    .create-btn {
        display: block;
        max-width: 200px;
        margin: 0 auto 20px auto;
        font-weight: bold;
    }

    .alert-info {
        max-width: 500px;
        margin: 20px auto;
        text-align: center;
        background-color: rgba(173, 216, 230, 0.85);
        border-radius: 10px;
        font-weight: bold;
    }
</style>

<h3>All Events</h3>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No events available currently.
    </div>
}

@if (Context.Session.GetString("Role") == "Admin")
{
    <a asp-action="Create" class="btn btn-primary create-btn">Create Event</a>
}

<div class="card-container">
    @foreach (var item in Model)
    {
        <div class="event-card">
            <div class="event-title">@item.Title</div>
            <div class="event-description">@item.Description</div>
            <div class="event-info"><strong>Date:</strong> @item.EventDate.ToShortDateString()</div>
            <div class="event-info"><strong>Location:</strong> @item.Location</div>

            <div class="btn-group">
                @if (Context.Session.GetString("Role") != "Admin")
                {
                    <a class="btn btn-primary btn-sm"
                       asp-controller="Registrations"
                       asp-action="RegisterEvent"
                       asp-route-eventId="@item.Id">
                        Register
                    </a>
                }

                @if (Context.Session.GetString("Role") == "Admin")
                {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Delete this event?')">
                        Delete
                    </a>
                }
            </div>
        </div>
    }
</div>
